# Sectile environment reference.
#
# Copy to .env (or .env.local) and fill in the values you need:
#
#     cp .env.sample .env
#
# Only the SERVER reads these files, at startup, from the working directory and
# then from the user data directory (~/.config/sectile/.env, or
# "~/Library/Application Support/sectile/.env" on macOS). A variable already
# exported in the shell always wins over the file, and nothing is re-read while
# the process runs: restart the server after any change.
#
# The AGENT never reads a .env file. Its variables must be exported in the shell
# that launches it, or declared in its service unit. They are listed below for
# reference, and because a single-workstation setup usually sources this file by
# hand before starting the agent.
#
# .env and .env.local are gitignored; this sample is not. Keep real credentials
# out of it.


# =============================================================================
# SERVER — runtime
# =============================================================================

# HTTP listening port. Default: 8090.
PORT=8090

# SQLite database path. When empty: ./tasks.db if it already exists, otherwise
# the user data directory. The -wal and -shm side files live next to it.
DB_PATH=./tasks.db


# =============================================================================
# SERVER — agent and MCP authentication
# =============================================================================

# Bearer credential required from agents and from the /mcp endpoint. LEAVING IT
# EMPTY ACCEPTS ANY NON-EMPTY TOKEN: acceptable on a personal workstation, never
# on a reachable deployment. The agent presents this value as TOKEN, unless it
# holds a device credential obtained through desktop pairing.
SECTILE_SERVER_TOKEN=

# Idle MCP session timeout, as a Go duration (30s, 15m, 1h). Default: 15m.
# An unparseable or negative value keeps the default rather than disabling it.
#SECTILE_MCP_SESSION_TIMEOUT=15m


# =============================================================================
# SERVER — tracker credentials
# =============================================================================
#
# Read by the server process only. A `gh` login on the same machine is NOT
# picked up. Without a usable token the board still loads from SQLite, but every
# tracker round-trip fails: task comments do not load and workflow stage
# transitions never reach the ticket.
#
# GitHub resolution order, first non-empty wins:
#   SECTILE_GITHUB_TOKEN -> SECTILE_TRACKER_TOKEN -> GH_TOKEN -> GITHUB_TOKEN

# Tracker-agnostic credential, used by every provider without an override.
SECTILE_TRACKER_TOKEN=

# GitHub-only override. Takes precedence over SECTILE_TRACKER_TOKEN, so a server
# driving several providers cannot send one provider's credential to another.
#SECTILE_GITHUB_TOKEN=

# GitHub REST base URL. Default: https://api.github.com
# GitHub Enterprise: https://<host>/api/v3
#SECTILE_GITHUB_API_URL=https://api.github.com

# Required scopes on the configured repositories:
#   fine-grained token -> Issues: read and write, Metadata: read
#   classic token      -> repo
# Quick local setup, tied to that CLI session rather than a durable credential:
#   SECTILE_TRACKER_TOKEN="$(gh auth token)"


# =============================================================================
# SERVER — web sign-in (optional, OpenID Connect)
# =============================================================================
#
# Without SECTILE_OIDC_ISSUER the server keeps a single implicit user, which is
# how a personal deployment runs. Once the issuer is set, the three required
# variables must all be present and the provider must be reachable at startup,
# or the server refuses to start.

#SECTILE_OIDC_ISSUER=https://id.example.com        # required, HTTPS only
#SECTILE_OIDC_CLIENT_ID=                           # required
#SECTILE_OIDC_REDIRECT_URL=https://sectile.example.com/auth/callback  # required
#SECTILE_OIDC_CLIENT_SECRET=                       # optional (public client)


# =============================================================================
# SERVER — development switches
# =============================================================================

# 1 lets any caller claim an identity through the X-Sectile-User header. This is
# an impersonation switch for exercising multiple users before real sign-in
# exists; a configured OIDC provider ignores it. Never enable it in production.
#SECTILE_DEV_IDENTITY=0


# =============================================================================
# AGENT — connection (exported in the shell, not loaded from this file)
# =============================================================================

# Server URL. Equivalent to --url, which takes precedence.
#REMOTE_URL=http://localhost:8090

# Credential presented to the server. Equivalent to --token, which takes
# precedence. Either the value of SECTILE_SERVER_TOKEN above, or a device
# credential obtained by pairing the desktop app.
#TOKEN=

# Other agent settings are flags without an environment fallback:
#   --project <id|all>   project scope, default all
#   --repo <path>        local clone, default: the current Git checkout
#   --device <name>      device identifier, default: hostname
#   --desktop-info       private connection file,
#                        default ~/.taskflow/agent-connection.json
#                        (it contains a credential)


# =============================================================================
# AGENT — local environment
# =============================================================================

# Terminal application. Ignored when --terminal is passed. Auto-detected
# otherwise: Ghostty, then iTerm, then Terminal.app on macOS; pty elsewhere.
#SECTILE_TERMINAL=

# Secret shared with the desktop companion. The agent generates a random one
# when unset, and the desktop app supplies its own when it starts the agent.
# Only set it to attach a companion to an agent started by hand.
#SECTILE_DESKTOP_TOKEN=

# Coding CLIs authenticate through their own login, not through this file:
# git, gh (gh auth login), then the engine you use (claude, codex, agy, vibe),
# plus uv / specify / openspec for the spec-driven frameworks.


# =============================================================================
# MCP stdio bridge — `sectile-agent mcp`
# =============================================================================

# Endpoint, first non-empty wins. Default: http://127.0.0.1:8090
#SECTILE_AGENT_URL=
#SECTILE_SERVER_URL=

# Bearer token for that endpoint. Equivalent to --token.
#SECTILE_AGENT_TOKEN=

# Name reported for this client session. Default: <hostname>/<pid>.
#SECTILE_MCP_CLIENT=


# =============================================================================
# DESKTOP APP (Electron) — no configuration required
# =============================================================================
#
# The first window asks for the server URL and token, and stores them. These
# variables only exist for isolated instances and tests.

#SECTILE_DESKTOP_DATA_DIR=   # alternative user data directory
#SECTILE_DESKTOP_TEST=       # 1 keeps the window hidden (test runs)


# =============================================================================
# Injected into executions — do not set these
# =============================================================================
#
# The agent sets them for each run, and skills read them:
# SECTILE_TASK_KEY, SECTILE_TASK_ID, SECTILE_TASK_BRANCH, SECTILE_TASK_WORKTREE,
# SECTILE_RUN_ID, SECTILE_PROJECT_ID, SECTILE_REMOTE_MODE.
