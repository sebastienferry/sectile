{
  "name": "sectile-tauri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ux-fixture": "vite --mode ux-fixture --host 127.0.0.1 --port 1422",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "package:macos": "node scripts/package-macos.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ui": "vitest run",
    "prepare:services": "node scripts/build-services.mjs",
    "licenses:javascript": "node scripts/generate-js-notices.mjs",
    "test:services": "node scripts/test-local-services.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "entities": "^8.1.0",
    "marked": "^18.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  }
}
