# Binaries & build artifacts
bin/
*.exe
/server

# Node / Web Dependencies
node_modules
/dist/
web/dist/
build/
.env
.env.local
# Written by scripts/set-env.sh before it rewrites the generated block.
.env.bak

# The filled-in environment manifest: it names a deployment's GCP projects,
# hosts and secrets. Only the .sample is published.
scripts/env-profiles.conf

# Databases & local state
*.db
*.db-shm
*.db-wal

# The key encrypting personal tracker credentials, written next to the database
# when SECTILE_SECRET_KEY is not set. A developer running the server from the
# repository gets one at the root, and it opens every unsealed token in any copy
# of that database.
secret.key
*.sqlite
*.sqlite3

# OS
.DS_Store
Thumbs.db

# Logs & Temp
*.log
tmp/
scratch/

# TaskFlow parallel agent worktrees and local runtime state
.tasks/
.taskflow/agent-manifest.json
.taskflow/config.json
.taskflow/remote-config.json
.taskflow/skill-backups/
.agents/mcp_config.json

# Interface compilée, embarquée dans le binaire au moment du build
internal/webui/dist/*
!internal/webui/dist/.gitkeep

# Agent installation bookkeeping and recovery copies (never an execution cache)
.taskflow/agent-manifest.json
.taskflow/config.json
.taskflow/remote-config.json
.taskflow/skill-backups/

# Managed skills and commands are installed in each agent's user configuration,
# never in the checkout. Copies left here by earlier releases are retired on the
# next dispatch; personal skills at other paths are untouched.
.agents/skills/
.agy/skills/
.claude/commands/
.claude/skills/
.gemini/skills/
.skills/
.mcp.json

# Local desktop build outputs
desktop/bin/
desktop/dist/
desktop/release/
desktop/release-*/

/desktop/release-companion/
